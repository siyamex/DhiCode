// examples/cultural_and_stdlib_demo.dhi - Demonstrating Phase 2 Cultural & Extended Standard Library in DHicode

print("=== 1. Maldivian Nakaiy Calendar (ނަކަތް) ===");
import "nakaiy";
let nak = today();
let m = monsoon();
let d = nakaiy_day();
print("މިއަދުގެ ނަކަތް: {nak[\"ނަން\"]} ({nak[\"name\"]})");
print("މޫސުން: {m}");
print("ނަކަތުގެ ދުވަސް: {d}");

print("\n=== 2. Maldivian Prayer Times & Hijri Calendar (ނަމާދު) ===");
import "prayer";
let times = today("މާލެ");
print("މާލޭގެ ނަމާދު ވަގުތުތައް:");
print("  ފަތިސް: {times[\"ފަތިސް\"]}");
print("  މެންދުރު: {times[\"މެންދުރު\"]}");
print("  ޢަޞުރު: {times[\"ޢަޞުރު\"]}");
print("  މަޣްރިބް: {times[\"މަޣްރިބް\"]}");
print("  ޢިޝާ: {times[\"ޢިޝާ\"]}");

let next_p = next_prayer("މާލެ");
print("ދެން އެންމެ އަވަހަށް އޮތީ: {next_p[\"ނަމާދު\"]} ({next_p[\"time\"]}) - ބާކީ {next_p[\"remaining_minutes\"]} މިނިޓް");

let hijri = hijri_date();
print("ހިޖުރީ ތާރީޚް: {hijri[\"ތާރީޚް\"]}");

print("\n=== 3. Thaana Language & Cultural Tools (ތާނަ) ===");
import "thaana";
let num_words = number_to_words(2026);
print("2026 ބަހުން: {num_words}");

let price = currency_mvr(4850.75);
print("އަގު: {price}");

let text = "ދިވެހިރާއްޖެ";
let stripped = strip_fili(text);
let latin = to_latin(text);
print("އަސްލު: {text}, ފިލި ފޮހެފައި: {stripped}, ލެޓިން: {latin}");

print("\n=== 4. Cryptography & Security (ކްރިޕްޓޯ) ===");
import "crypto";
let message = "DhiCode Secure Key 2026";
let hash_val = sha256(message);
let b64 = base64_encode(message);
let token = random_token(8);
print("SHA-256: {hash_val}");
print("Base64: {b64}");
print("Secure Token: {token}");

print("\n=== 5. Regular Expressions (ރެގެކްސް) ===");
import "regex";
let log_line = "Error code [500] in server-alpha";
let match_res = search("\[(\d+)\]", log_line);
if match_res != null
    print("ފެނުނު ކޯޑު: {match_res[\"text\"]}");
end

let clean = replace("[^a-zA-Z0-9 ]+", " ", log_line);
print("ސާފުކުރެވުނު ލިޔުން: {clean}");

print("\n=== 6. Math & System Extensions (ހިސާބު އަދި ނިޒާމު) ===");
import "math";
import "os";
let root = sqrt(144);
let abs_val = abs(-99);
let plat = platform();
print("ޖަޒުރު(144) = {root}, މުތުލަޤު(-99) = {abs_val}");
print("ހިންގާ ނިޒާމު: {plat}");
