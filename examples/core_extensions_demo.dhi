// examples/core_extensions_demo.dhi - Demonstrating Phase 1 Core Extensions in DHicode

print("=== 1. Dual Keywords & String Interpolation ===");
let name = "އަޙްމަދު";
let age = 25;
print("މަރުޙަބާ {name}! ތިބާގެ ޢުމުރަކީ {age} އަހަރު.");

print("\n=== 2. Constants & Immutability ===");
const PI = 3.14159;
ދާއިމީ ޤައުމު = "ދިވެހިރާއްޖެ";
print("PI: {PI}, ޤައުމު: {ޤައުމު}");

print("\n=== 3. Compound Assignment & Mutations ===");
let score = 50;
score += 25;
score -= 5;
score *= 2;
score /= 7;
print("ނަތީޖާ: {score}");

let items = [10, 20, 30];
items[1] = 99;
items[0] += 5;
print("ލިސްޓު: {items}");

print("\n=== 4. Exponentiation (**) & Null Coalescing (??) ===");
let pow1 = 2 ** 8;
let pow2 = 2 ** 3 ** 2; // Right-associative: 2 ** 9 = 512
print("2 ** 8 = {pow1}, 2 ** 3 ** 2 = {pow2}");

let user_input = null;
let display_name = user_input ?? "މެހެމާނު";
print("ނަން: {display_name}");

print("\n=== 5. Bitwise Operators ===");
let a = 5 & 3;
let b = 5 | 2;
let c = 5 ^ 1;
let shl = 1 << 4;
let shr = 32 >> 3;
print("5 & 3 = {a}, 5 | 2 = {b}, 5 ^ 1 = {c}");
print("1 << 4 = {shl}, 32 >> 3 = {shr}");

print("\n=== 6. English Functions & Loops ===");
fn calculate_total(prices)
    let total = 0;
    for price in prices
        total += price;
    end
    return total;
end

let basket = [100, 250, 40, 15];
let grand_total = calculate_total(basket);
print("ޖުމްލަ އަގު: {grand_total} ރުފިޔާ");
