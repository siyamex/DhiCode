// examples/advanced.dhi - މަތީ ފެންވަރުގެ މިސާލުތައް

// 1. ހިސާބު މޮޑިއުލް އެތެރެކުރުން
ގެނޭ "ހިސާބު"

ދައްކާ "=== 1. ހިސާބު މޮޑިއުލް ==="
ދައްކާ "144 ގެ ޖަޒުރު: " + ޖަޒުރު(144)
ދައްކާ "3 ގެ 4 ވަނަ ބާރު: " + ބާރު(3, 4)
ދައްކާ "ޕައި ގެ އަގު: " + ޕައި

// 2. ލިސްޓާއި ކޮންމެ (For-Each) ލޫޕް
ދައްކާ ""
ދައްކާ "=== 2. ލިސްޓާއި ލޫޕް ==="
ކަނޑައަޅާ ރަށްތައް = ["މާލެ", "ހުޅުމާލެ", "ވިލިމާލެ"]
އަޅާ(ރަށްތައް, "ކުޅުދުއްފުށި")

ކޮންމެ ރަށް ތެރޭގައި ރަށްތައް
    ދައްކާ "ރަށް: " + ރަށް
ނިމުނީ

// 3. ރަދީފު (Dictionary)
ދައްކާ ""
ދައްކާ "=== 3. ރަދީފު (Dictionary) ==="
ކަނޑައަޅާ ޕްރޮފައިލް = {"ނަން": "ޢަލީ", "ވަޒީފާ": "ޑިވެލޮޕަރ", "އުމުރު": 28}
ދައްކާ "ނަން: " + ޕްރޮފައިލް["ނަން"]
ދައްކާ "ވަޒީފާ: " + ޕްރޮފައިލް["ވަޒީފާ"]

// 4. ކުށް ސަލާމަތްކުރުން (Try/Catch)
ދައްކާ ""
ދައްކާ "=== 4. ކުށް ސަލާމަތްކުރުން (Exception Handling) ==="
މަސައްކަތްކުރޭ
    ކަނޑައަޅާ ނަތީޖާ = 50 / 0
ކުށެއް_ފެނިއްޖެނަމަ މައްސަލަ
    ދައްކާ "ހުއްޓުމަކާނުލައި ސަލާމަތްކުރެވުނު ކުށް: " + މައްސަލަ
ނިމުނީ

ދައްކާ "ހުރިހާ މިސާލެއް ފުރިހަމަވެއްޖެ!"
