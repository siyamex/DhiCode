{
  "name": "dhicode",
  "displayName": "DhiCode (ދިވެހި ކޯޑު)",
  "description": "Language support, syntax highlighting, LSP hover docs, formatting, and runner for DhiCode - Dhivehi programming language",
  "version": "0.3.0",
  "publisher": "siyamex",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dhicode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/siyamex/DhiCode"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "dhicode",
    "dhivehi",
    "thaana",
    "maldives",
    "programming language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dhicode",
        "aliases": [
          "DhiCode",
          "dhicode",
          "Dhivehi"
        ],
        "extensions": [
          ".dhi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dhicode",
        "scopeName": "source.dhicode",
        "path": "./syntaxes/dhicode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dhicode",
        "path": "./snippets/dhicode.json"
      }
    ],
    "commands": [
      {
        "command": "dhicode.run",
        "title": "DhiCode: Run Script (ހިންގާ)",
        "category": "DhiCode"
      },
      {
        "command": "dhicode.build",
        "title": "DhiCode: Build Standalone Binary (ބިލްޑް)",
        "category": "DhiCode"
      }
    ]
  }
}
