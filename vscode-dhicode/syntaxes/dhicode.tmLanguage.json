{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DhiCode",
  "scopeName": "source.dhicode",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-operator" },
    { "include": "#keywords-builtin" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dhicode",
          "match": "//.*$"
        },
        {
          "name": "comment.block.dhicode",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.dhicode",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dhicode",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.dhicode",
          "match": "(?<![\\u0780-\\u07BFa-zA-Z0-9_])\\d+(\\.\\d+)?([eE][+-]?\\d+)?(?![\\u0780-\\u07BFa-zA-Z0-9_])"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.dhicode",
          "match": "(?<![\\u0780-\\u07BFa-zA-Z0-9_])(އާން|ނޫން)(?![\\u0780-\\u07BFa-zA-Z0-9_])"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.dhicode",
          "match": "(?<![\\u0780-\\u07BFa-zA-Z0-9_])(ނަމަ|ނޫންނަމަ|ހިނދު|ނިމުނީ|ފޮނުވާ)(?![\\u0780-\\u07BFa-zA-Z0-9_])"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.dhicode",
          "match": "(?<![\\u0780-\\u07BFa-zA-Z0-9_])(ކަނޑައަޅާ|ވަޒީފާ|ބަހައްޓާ|ފަންކް)(?![\\u0780-\\u07BFa-zA-Z0-9_])"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.dhicode",
          "match": "(?<![\\u0780-\\u07BFa-zA-Z0-9_])(އަދި|ނުވަތަ)(?![\\u0780-\\u07BFa-zA-Z0-9_])"
        }
      ]
    },
    "keywords-builtin": {
      "patterns": [
        {
          "name": "support.function.dhicode",
          "match": "(?<![\\u0780-\\u07BFa-zA-Z0-9_])(ދައްކާ|ލިޔޭ|މައި)(?![\\u0780-\\u07BFa-zA-Z0-9_])"
        }
      ]
    },
    "function-call": {
      "match": "([\\u0780-\\u07BFa-zA-Z_][\\u0780-\\u07BFa-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.dhicode"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.dhicode",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.dhicode",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.dhicode",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.dhicode",
          "match": "[\\u0780-\\u07BFa-zA-Z_][\\u0780-\\u07BFa-zA-Z0-9_]*"
        }
      ]
    }
  }
}
